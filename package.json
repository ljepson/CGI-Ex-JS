{
  "name": "cgi-ex-js",
  "version": "1.0.0",
  "description": "JavaScript port of the CGI::Ex::App Perl module - Web application framework with validation and multi-step workflows",
  "main": "lib/app.js",
  "scripts": {
    "test": "mocha",
    "test:unit": "mocha test/unit/**/*.test.js",
    "test:integration": "mocha test/integration/**/*.test.js",
    "test:watch": "mocha --watch",
    "start": "node server.js",
    "example": "node examples/simple-form.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ljepson/CGI-Ex-JS"
  },
  "keywords": [
    "cgiex",
    "cgi-ex",
    "node-app"
  ],
  "author": "ljepson",
  "license": "MIT",
  "engines": {
    "node": ">=12.0.0"
  },
  "dependencies": {
    "underscore": "^1.13.6"
  },
  "devDependencies": {
    "mocha": "^10.2.0",
    "chai": "^4.3.10",
    "sinon": "^17.0.1",
    "supertest": "^6.3.3"
  },
  "optionalDependencies": {
    "connect": "^3.7.0",
    "quip": "^0.1.2",
    "serve-favicon": "^2.5.0",
    "body-parser": "^1.20.2",
    "morgan": "^1.10.0"
  },
  "bugs": {
    "url": "https://github.com/ljepson/CGI-Ex-JS/issues"
  },
  "homepage": "https://github.com/ljepson/CGI-Ex-JS"
}
